# Nonefinity SDK Configuration
# Copy this file to .env and fill in your credentials

# Your chat configuration ID from Nonefinity dashboard
VITE_CHAT_CONFIG_ID=your-chat-config-id-here

# Your API key from Nonefinity dashboard
VITE_API_KEY=your-api-key-here

# API URL (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000
