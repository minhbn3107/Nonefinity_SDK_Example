# Nonefinity SDK Configuration
# Copy this file to .env and fill in your credentials

# REQUIRED: Your API key from Nonefinity dashboard
VITE_API_KEY=your-api-key-here

# OPTIONAL: Override the chat configuration used by the demos
# If not set, the SDK will automatically use your first available chat config
# VITE_CHAT_CONFIG_ID=your-chat-config-id-here

# OPTIONAL: Override the API URL
# If not set, the SDK defaults to http://localhost:8000/api/v1 in dev
# and https://api.nonefinity.com/api/v1 in production
# VITE_API_URL=http://localhost:8000/api/v1
